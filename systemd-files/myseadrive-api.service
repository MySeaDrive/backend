[Unit]
Description=MySeaDrive FastAPI API (Production)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/backend
ExecStart=/home/deploy/.venv/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 7001 --workers 4
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=ENV=production

[Install]
WantedBy=multi-user.target
