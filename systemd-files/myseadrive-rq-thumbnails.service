[Unit]
Description=RQ Worker - Thumbnails (Production)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/backend
ExecStart=/home/deploy/.venv/bin/uv run rq worker thumbnails
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=ENV=production

[Install]
WantedBy=multi-user.target
